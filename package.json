{
  "name": "web-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run db:migrate && next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "node -e 'require(\"child_process\").execSync(\"npx tsx src/db/migrate.ts\", { stdio: \"inherit\" })'",
    "db:seed": "node -e 'require(\"child_process\").execSync(\"npx tsx src/db/seed.ts\", { stdio: \"inherit\" })'",
    "db:clean": "node -e 'require(\"child_process\").execSync(\"npx tsx src/db/clean.ts\", { stdio: \"inherit\" })'"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.45.0",
    "next": "16.3.5",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
